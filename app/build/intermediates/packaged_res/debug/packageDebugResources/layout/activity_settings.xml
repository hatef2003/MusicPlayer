<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Terminal header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="// settings"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- ═══ THEME ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THEME"
            android:textColor="@color/terminal_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Light"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/terminal_dim"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- ═══ SORT ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEFAULT_SORT"
            android:textColor="@color/terminal_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/sortGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/sortTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/sortArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artist"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/sortAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Album"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/sortDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duration"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/sortDateAdded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date Added"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/terminal_dim"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- ═══ ACCENT COLOR ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACCENT_COLOR"
            android:textColor="@color/terminal_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/accentColorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/accentGreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Green"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/accentBlue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blue"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/accentOrange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Orange"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />

            <RadioButton
                android:id="@+id/accentPurple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Purple"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="?attr/colorSecondary" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/terminal_dim"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/terminal_dim"
            android:textSize="10sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
