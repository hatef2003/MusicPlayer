<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/md_bg"
    android:padding="24dp">

    <androidx.mediarouter.app.MediaRouteButton
        android:id="@id/mediaRouteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:mediaRouteTypes="user"
        app:mediaRouteButtonTint="?attr/colorSecondary" />

    <ImageView
        android:id="@+id/npAlbumArt"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_album"
        android:scaleType="centerCrop"
        android:background="@color/md_surface"
        android:padding="1dp"
        android:contentDescription="Album art" />

    <TextView
        android:id="@+id/npTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="Song Title" />

    <TextView
        android:id="@+id/npArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="Artist Name" />

    <TextView
        android:id="@+id/npAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="?attr/colorSecondary"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="Album Name" />

    <SeekBar
        android:id="@+id/npSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:progressTint="?attr/colorSecondary"
        android:thumbTint="?attr/colorSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/npCurrentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            tools:text="0:00" />

        <TextView
            android:id="@+id/npTotalTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            tools:text="3:45" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/npPrev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:src="@drawable/ic_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous" />

        <ImageView
            android:id="@+id/npPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:padding="16dp"
            android:src="@drawable/ic_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause" />

        <ImageView
            android:id="@+id/npNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:src="@drawable/ic_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next" />

    </LinearLayout>

</LinearLayout>
