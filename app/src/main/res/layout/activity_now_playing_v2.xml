<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_bg"
    android:padding="16dp">

    <!-- ═══ TOP BAR ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/npBackBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:text="// now_playing"
            android:textStyle="bold" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@id/mediaRouteButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:mediaRouteTypes="user"
            app:mediaRouteButtonTint="@color/terminal_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:text="⋮" />
    </LinearLayout>

    <!-- ═══ ALBUM ART + SONG INFO (side by side) ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- Album art with green border -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/npAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_album"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Album art" />

            <!-- Green border overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/album_border" />
        </FrameLayout>

        <!-- Song info (right side) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/npHackerTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_dim"
                android:textSize="9sp"
                android:text="TRACK_01"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/npTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_green"
                android:textSize="22sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="From the Inside" />

            <TextView
                android:id="@+id/npArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Linkin Park" />

            <TextView
                android:id="@+id/npAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Meteora" />

            <TextView
                android:id="@+id/npMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_dim"
                android:textSize="10sp"
                tools:text="MP3 • 320kbps • 44.1kHz • Stereo" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ DIVIDER ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_dim"
        android:layout_marginBottom="12dp" />

    <!-- ═══ PROGRESS BAR ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/npCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="1:12" />

        <SeekBar
            android:id="@+id/npSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:progressTint="?attr/colorSecondary"
            android:thumbTint="?attr/colorSecondary" />

        <TextView
            android:id="@+id/npTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="2:53" />
    </LinearLayout>

    <!-- ═══ DIVIDER ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_dim"
        android:layout_marginBottom="8dp" />

    <!-- ═══ TABS + ACTION BUTTONS ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/npTabLyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Lyrics"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/npTabInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="Info"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/npTabQueue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="Queue"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/npHackerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/terminal_dim"
            android:textSize="9sp"
            android:text="PLAYING" />

        <TextView
            android:id="@+id/npIdentifyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="🔍"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/npSaveBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="💾"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/npRefreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="↻"
            android:textSize="16sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ═══ DIVIDER ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_dim"
        android:layout_marginBottom="4dp" />

    <!-- ═══ LYRICS PANEL (default visible) ═══ -->
    <LinearLayout
        android:id="@+id/npLyricsPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Lyrics header (synced label + actions) -->
        <LinearLayout
            android:id="@+id/npLyricsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/npLyricsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="SYNCED" />

            <TextView
                android:id="@+id/npSyncToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_green"
                android:textSize="10sp"
                android:text="SYNC"
                android:padding="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/npFetchBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="FETCH"
                android:padding="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Lyrics RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/npLyricsRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- No lyrics fallback -->
        <LinearLayout
            android:id="@+id/npNoLyricsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_dim"
                android:textSize="12sp"
                android:text="// no lyrics available"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/npSpeechBtn">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/terminal_green"
                    android:textSize="12sp"
                    android:text="[ SPEAK ]" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ INFO PANEL (hidden by default) ═══ -->
    <ScrollView
        android:id="@+id/npInfoPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/npInfoContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                tools:text="Title: Song Name\nArtist: Artist\nAlbum: Album\nFormat: MP3\n..." />
        </LinearLayout>
    </ScrollView>

    <!-- ═══ QUEUE PANEL (hidden by default) ═══ -->
    <LinearLayout
        android:id="@+id/npQueuePanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/npQueueRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- ═══ DIVIDER ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_dim"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- ═══ PLAYBACK CONTROLS ═══ -->
    <LinearLayout
        android:id="@+id/npPlaybackControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/npShuffle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_shuffle"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shuffle"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/npPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:padding="10dp"
            android:src="@drawable/ic_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/npPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:padding="14dp"
            android:src="@drawable/ic_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause"
            app:tint="@color/terminal_green" />

        <ImageView
            android:id="@+id/npNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/npRepeat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:padding="6dp"
            android:src="@drawable/ic_repeat"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repeat"
            app:tint="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
