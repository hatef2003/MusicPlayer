<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/techMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Glow layer behind the card -->
    <LinearLayout
        android:id="@+id/techMenuGlow"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_tech_menu_glow"
        android:padding="4dp">

        <!-- Main card -->
        <LinearLayout
            android:id="@+id/techMenuCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tech_menu_container"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Song header (optional, shown for songs) -->
            <LinearLayout
                android:id="@+id/techMenuHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_tech_menu_item_ripple">

                <ImageView
                    android:id="@+id/techMenuAlbumArt"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_album"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/techMenuSongTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#F2F2F2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="From the Inside" />

                    <TextView
                        android:id="@+id/techMenuSongArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="#8A8A8A"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="Linkin Park • Meteora" />
                </LinearLayout>
            </LinearLayout>

            <!-- Header divider -->
            <View
                android:id="@+id/techMenuHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#0AFFFFFF"
                android:visibility="gone" />

            <!-- Menu items container - populated dynamically -->
            <LinearLayout
                android:id="@+id/techMenuItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
