<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="#101010"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <!-- Album art - small in collapsed -->
    <ImageView
        android:id="@+id/notifAlbumArt"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:background="#39FF6A"
        android:padding="1dp" />

    <!-- Song info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/notifTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Music Player"
            android:textColor="#39FF6A"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notifArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#8A8A8A"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Controls: pause + next -->
    <ImageView
        android:id="@+id/notifPlayPause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_notif_pause_green"
        android:contentDescription="Play/Pause" />

    <ImageView
        android:id="@+id/notifNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_notif_next_green"
        android:contentDescription="Next" />

</LinearLayout>
