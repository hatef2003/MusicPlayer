<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="// telegram"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tgRefreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REFRESH"
            android:textColor="@color/terminal_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_dim" />

    <!-- Status / breadcrumb -->
    <TextView
        android:id="@+id/tgStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- Progress bar (for loading states) -->
    <ProgressBar
        android:id="@+id/tgProgressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="@color/terminal_green"
        android:backgroundTint="@color/terminal_dim" />

    <TextView
        android:id="@+id/tgExportBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EXPORT TO PLAYLIST"
        android:textColor="@color/terminal_green"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="10dp"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground" />

    <!-- Main list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tgList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tgEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:padding="32dp"
        android:visibility="gone" />

</LinearLayout>
