<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Drag handle -->
    <TextView
        android:id="@+id/qDragHandle"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/terminal_dim"
        android:textSize="14sp"
        android:gravity="center"
        android:text="⋮⋮" />

    <!-- Index number -->
    <TextView
        android:id="@+id/qIndex"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center"
        tools:text="01" />

    <!-- 1dp vertical separator -->
    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:background="@color/terminal_dim"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp" />

    <!-- Song info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/qTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="From the Inside" />

        <TextView
            android:id="@+id/qArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            tools:text="Linkin Park" />
    </LinearLayout>

    <!-- Duration -->
    <TextView
        android:id="@+id/qDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/terminal_green"
        android:textSize="11sp"
        android:layout_marginStart="8dp"
        tools:text="2:53" />

    <!-- Remove button -->
    <TextView
        android:id="@+id/qRemove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:padding="6dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="✕" />

</LinearLayout>
