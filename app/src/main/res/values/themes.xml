<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MusicPlayer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorPrimaryVariant">@color/md_primary_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/md_accent</item>
        <item name="colorSecondaryVariant">@color/md_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/md_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/md_primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorControlActivated">@color/md_accent</item>
        <item name="colorControlHighlight">@color/md_accent</item>
    </style>

    <style name="Theme.MusicPlayer.Green" parent="Theme.MusicPlayer" />

    <style name="Theme.MusicPlayer.Blue" parent="Theme.MusicPlayer">
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorControlActivated">@color/accent_blue</item>
        <item name="colorControlHighlight">@color/accent_blue</item>
    </style>

    <style name="Theme.MusicPlayer.Orange" parent="Theme.MusicPlayer">
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorSecondaryVariant">@color/accent_orange</item>
        <item name="colorControlActivated">@color/accent_orange</item>
        <item name="colorControlHighlight">@color/accent_orange</item>
    </style>

    <style name="Theme.MusicPlayer.Purple" parent="Theme.MusicPlayer">
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorSecondaryVariant">@color/accent_purple</item>
        <item name="colorControlActivated">@color/accent_purple</item>
        <item name="colorControlHighlight">@color/accent_purple</item>
    </style>
    <style name="TerminalTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
